# Stage 1: Builder
FROM node:22-alpine AS builder

# Install build dependencies
RUN apk add --no-cache ffmpeg ca-certificates python3 make g++ libc6-compat

WORKDIR /app

# Copy package files from sonata-src/
COPY sonata-src/package.json sonata-src/package-lock.json ./

# Install ALL dependencies (including dev) for building
# Explicitly install the arm64-musl binding for davey as npm optional resolution can be flaky on Alpine
RUN npm install && npm install @snazzah/davey-linux-arm64-musl

# Copy the rest of the source
COPY sonata-src/tsconfig.json ./
COPY sonata-src/src/ ./src/
COPY sonata-src/assets/ ./assets/
COPY sonata-src/bin/ ./bin/

# Build the project
RUN npm run build

# Stage 2: Production
FROM node:22-alpine

# Install runtime dependencies
RUN apk add --no-cache ffmpeg ca-certificates libc6-compat

WORKDIR /app

# Copy package files
COPY sonata-src/package.json sonata-src/package-lock.json ./

# Install production dependencies
# Explicitly install the arm64-musl binding for davey
RUN apk add --no-cache python3 make g++ \
    && npm install --omit=dev --no-audit --no-fund @snazzah/davey-linux-arm64-musl \
    && apk del python3 make g++

# Copy built files from builder
COPY --from=builder /app/dist/ ./dist/
COPY --from=builder /app/bin/ ./bin/
COPY sonata-src/config.example.js ./config.js

EXPOSE 2333

ENTRYPOINT ["node", "dist/index.js"]
